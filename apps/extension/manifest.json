{
  "manifest_version": 3,
  "name": "CEDT Hub",
  "version": "0.1.0",
  "description": "Keeps your CEDT Intern Portal session synced with your CEDT Hub, so you never paste a cookie.",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": [
    "https://cedtintern.cp.eng.chula.ac.th/*",
    "https://hub.witsanupong-kolakul.com/*",
    "https://dev.hub.witsanupong-kolakul.com/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "CEDT Hub",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": [
        "https://hub.witsanupong-kolakul.com/extension/connect*",
        "https://dev.hub.witsanupong-kolakul.com/extension/connect*",
        "http://localhost/extension/connect*"
      ],
      "js": ["pair.js"],
      "run_at": "document_start"
    }
  ]
}
