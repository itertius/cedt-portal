# Copy to apps/web/.env.local for local development.
# Vercel sets VERCEL_ENV, VERCEL_URL and VERCEL_GIT_COMMIT_SHA automatically.

# Postgres. Local: `docker compose up -d` (set POSTGRES_PORT=5433 if 5432 is taken).
# Vercel: Neon pooled connection string.
DATABASE_URL="postgres://cedt@localhost:5432/cedt_hub"

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public URL of this deployment (no trailing slash). Optional on Vercel.
BETTER_AUTH_URL="http://localhost:3000"

# MyCourseVille OAuth app (ask the MCV team for a client).
# Redirect URI to register: <BETTER_AUTH_URL>/api/auth/callback/mcv
MCV_CLIENT_ID=""
MCV_CLIENT_SECRET=""

# Protects /api/cron/sync (Vercel Cron sends it as a Bearer token). openssl rand -hex 32
CRON_SECRET=""

# Local only: point MCV calls at the mock server (node apps/web/scripts/mock-mcv.mjs).
# MCV_BASE_URL="http://localhost:4010"

# Google Calendar two-way sync (Google Cloud OAuth client, Web application).
# Redirect URI to register: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Local only: point Google calls at the mock (node apps/web/scripts/mock-google.mjs).
# GOOGLE_BASE_URL="http://localhost:4020"
