{
  "name": "cedt-hub",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "format": "biome format --write .",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @cedt-hub/db generate",
    "db:migrate": "pnpm --filter @cedt-hub/db migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "turbo": "^2.11.13"
  }
}
